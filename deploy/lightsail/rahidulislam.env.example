DJANGO_DEBUG=false
DJANGO_SECRET_KEY=replace-with-a-long-random-production-secret
DJANGO_ALLOWED_HOSTS=rahidulislam.com,www.rahidulislam.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://rahidulislam.com,https://www.rahidulislam.com
DJANGO_DATABASE_PATH=/var/lib/rahidulislam/db.sqlite3
DJANGO_MEDIA_ROOT=/var/lib/rahidulislam/media
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_SECURE_HSTS_SECONDS=3600
