DJANGO_DEBUG=false
DJANGO_SECRET_KEY=replace-with-a-long-random-production-secret
DJANGO_ALLOWED_HOSTS=rahidulislam.dev,www.rahidulislam.dev
# One public origin for canonical, social and sitemap URLs (no trailing slash).
DJANGO_SITE_URL=https://rahidulislam.dev
DJANGO_CSRF_TRUSTED_ORIGINS=https://rahidulislam.dev,https://www.rahidulislam.dev
DJANGO_DATABASE_PATH=/var/lib/rahidulislam/db.sqlite3
DJANGO_MEDIA_ROOT=/var/lib/rahidulislam/media
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_SECURE_HSTS_SECONDS=3600

# The local nginx proxy connects over a unix socket; trust only it for client IPs.
DJANGO_TRUSTED_PROXIES=unix
